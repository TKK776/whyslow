exports[`fixture corpus > nested-loop-hot.json > produces stable findings 1`] = `
[
  {
    "body": "This nested loop executed its inner side 48k times, costing 1.49 s in total. Nested loops are efficient when the inner side is a quick index lookup and the outer side is small. When the outer side is this large, a hash join is usually cheaper, and Postgres picked this plan because it underestimated the outer row count.",
    "node": 0,
    "rule": "nested-loop-hot",
    "severity": "high",
    "title": "Inner side ran 48k times",
  },
  {
    "body": "The planner expected 220 rows here and got 48k, so far more than it predicted. Bad estimates at this level push Postgres toward the wrong join strategy above it, which is often the real cause of the slowdown rather than this node itself. Run ANALYZE on sessions; if the estimate stays wrong, raise the statistics target on the columns involved or add extended statistics if two columns are correlated.",
    "node": 1,
    "rule": "row-estimate-off",
    "severity": "high",
    "title": "Row estimate off by 219x",
  },
]
`;


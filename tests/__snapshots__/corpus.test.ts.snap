exports[`fixture corpus > index-wrong-columns.json > produces stable findings 1`] = `
[
  {
    "body": "The planner expected 40k rows here and got 812, so far fewer than it predicted. Bad estimates at this level push Postgres toward the wrong join strategy above it, which is often the real cause of the slowdown rather than this node itself. Run ANALYZE on tickets; if the estimate stays wrong, raise the statistics target on the columns involved or add extended statistics if two columns are correlated.",
    "node": 0,
    "rule": "row-estimate-off",
    "severity": "medium",
    "title": "Row estimate off by 49x",
  },
  {
    "body": "The index found 216k rows, then a filter discarded 215k of them. The index matches part of the query but not the part doing the real narrowing. Adding state to the index would let it reject those rows before fetching them from the heap.",
    "node": 0,
    "rule": "index-wrong-columns",
    "severity": "medium",
    "title": "Index is on the wrong columns",
  },
]
`;


exports[`fixture corpus > seq-scan-disk-sort.json > produces stable findings 1`] = `
[
  {
    "body": "This sort needed 40 MB but work_mem was smaller, so it wrote temporary files and read them back. Raising work_mem above 40 MB for this query keeps the sort in memory. Set it per session or per role rather than globally, since work_mem is allocated per sort and a high global value multiplied across concurrent queries can exhaust memory.",
    "node": 0,
    "rule": "sort-spilled",
    "severity": "high",
    "title": "Sort spilled to disk",
  },
  {
    "body": "Read 4.2M rows from orders and threw away 3.8M of them, which is 90% wasted work. An index on status and placed_at would let Postgres jump straight to the matching rows instead of walking the whole table.",
    "node": 2,
    "rule": "seq-scan-discarding",
    "severity": "high",
    "title": "Missing index",
  },
  {
    "body": "The planner expected 21k rows here and got 412k, so far more than it predicted. Bad estimates at this level push Postgres toward the wrong join strategy above it, which is often the real cause of the slowdown rather than this node itself. Run ANALYZE on orders; if the estimate stays wrong, raise the statistics target on the columns involved or add extended statistics if two columns are correlated.",
    "node": 2,
    "rule": "row-estimate-off",
    "severity": "medium",
    "title": "Row estimate off by 20x",
  },
  {
    "body": "Scanned all 50k rows of customers. That is the right choice when the query genuinely needs most of the table, but worth checking whether an index exists for how this query filters or joins.",
    "node": 4,
    "rule": "seq-scan-discarding",
    "severity": "medium",
    "title": "Full table scan",
  },
  {
    "body": "Fetched 68k blocks (535 MB) from disk against 2.1k from shared_buffers. This data is not resident in cache, so the timing here will look very different on a warm run. Time this query twice before drawing conclusions from it.",
    "node": 2,
    "rule": "cold-cache",
    "severity": "low",
    "title": "Reading from disk, not cache",
  },
]
`;


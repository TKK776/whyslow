[
  {
    "body": "48k blocks were tracked at page level rather than row level (against 1.2k exact), because the bitmap outgrew work_mem. Postgres then had to recheck every row on those pages. Raising work_mem keeps the bitmap exact and removes the recheck.",
    "node": 0,
    "rule": "bitmap-lossy",
    "severity": "medium",
    "title": "Bitmap scan went lossy",
  },
  {
    "body": "Fetched 44k blocks (344 MB) from disk against 8.2k from shared_buffers. This data is not resident in cache, so the timing here will look very different on a warm run. Time this query twice before drawing conclusions from it.",
    "node": 0,
    "rule": "cold-cache",
    "severity": "low",
    "title": "Reading from disk, not cache",
  },
]
`;

